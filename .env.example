# Proxy Configuration (optional but recommended for production to avoid rate limiting)
# Supports any residential proxy provider (SmartProxy, Proxy-Cheap, BrightData, etc.)
# Format: username:password (proxy provider will give you these credentials)
PROXY_USERNAME=your_proxy_username
PROXY_PASSWORD=your_proxy_password
# For Proxy-Cheap: PROXY_HOST format is usually: resi.proxy-cheap.com:31112
# For SmartProxy: PROXY_HOST format is usually: ph.smartproxy.com:40003
PROXY_HOST=resi.proxy-cheap.com:31112

# YouTube Data API Configuration (required for video details)
YOUTUBE_API_KEY=your_youtube_api_key_here

# OpenAI API Configuration (required for AI summarization)
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
PORT=8020
